{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/annot/annot/analysis.schema.json",
  "title": "annot AI analysis proposal",
  "description": "Semantic analysis produced by an AI host. Every node must quote exact source lines; annot validates the proposal before rendering it.",
  "type": "object",
  "required": ["schema_version", "skill", "source_sha", "nodes", "edges"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "source_sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "summary": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "label", "start", "end", "quote"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
          "type": { "enum": ["stage", "decision", "gate", "artifact", "external", "note"] },
          "label": { "type": "string", "minLength": 1 },
          "subtitle": { "type": "string" },
          "start": { "type": "integer", "minimum": 1 },
          "end": { "type": "integer", "minimum": 1 },
          "quote": { "type": "string", "minLength": 1 },
          "lane": { "enum": ["reader", "tool", "model", "output"] },
          "topics": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1 }, "description": "What the card is about, in the analyst's own words (3–5 tags). Shared tags are how a rule finds the cards it governs, so this is semantic segmentation done by the model, not by character n-grams." },
          "references": { "type": "array", "items": { "type": "string" }, "description": "Gates only: ids of the cards this rule governs. Authoritative — the binding pass never overrides it." },
          "phase": { "type": "string" },
          "noteRole": { "enum": ["principle", "rationale", "definition", "trigger", "context", "risk", "example", "reference"] },
          "associationScope": { "enum": ["node", "skill", "unbound"], "description": "Notes: node/skill/unbound as before. Gates: omit it unless the rule section itself speaks for the whole Skill (硬信念 / 红线 / 验证清单) — annot binds every unbound gate to the action it governs." },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string" },
          "openBranches": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "additionalProperties": true,
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["sequence", "branch"] },
          "when": { "type": "string" },
          "reason": { "type": "string", "description": "Why this edge exists, quoting the source connective when it jumps a ## section. A sequence edge that crosses chapters without a reason is rejected." }
        }
      }
    },
    "associations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "relation"],
        "additionalProperties": true,
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "relation": { "enum": ["supports", "constrains", "informs", "explains-output"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
