{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/annot/annot/flow.schema.json",
  "title": "annot flow document",
  "description": "One skill's graph, as `annot annotate` writes it. This is the artifact every other command reads: `check` compares its anchors, `render` draws it, `context` slices it for an edit. A version field comes first because a reader that guesses the shape is a reader that silently misreads an old file.",
  "type": "object",
  "required": [
    "schema_version",
    "skill",
    "source",
    "nodes",
    "edges",
    "sections",
    "stats"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Bumped only for a breaking change to a field another command reads."
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "file",
        "sha",
        "lines",
        "generated_at"
      ],
      "additionalProperties": true,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Path as the caller named it; relative when the caller was."
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the whole SKILL.md. A change here means every anchor below may be meaningless."
        },
        "lines": {
          "type": "integer",
          "minimum": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "enum": ["rules", "ai"],
          "description": "Semantic method that produced the graph."
        },
        "analysis_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "phases": {
      "type": "array",
      "description": "Columns the author declared, one per heading that names a stage (`Phase 1`, `阶段二`, `Step 3`). Empty when the skill declares none; the layout then falls back to pure sequence depth.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "nodes"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^p\\d+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "The heading text, trimmed to what a column header can hold."
          },
          "nodes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "level",
          "start"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s\\d+$"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "start": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "byType",
        "byLane",
        "lowConfidence",
        "stale",
        "maxDepth"
      ],
      "additionalProperties": true,
      "properties": {
        "byType": {
          "type": "object",
          "required": [
            "stage",
            "decision",
            "gate",
            "artifact",
            "external",
            "note"
          ],
          "additionalProperties": true,
          "properties": {
            "stage": {
              "type": "integer",
              "minimum": 0
            },
            "decision": {
              "type": "integer",
              "minimum": 0
            },
            "gate": {
              "type": "integer",
              "minimum": 0
            },
            "artifact": {
              "type": "integer",
              "minimum": 0
            },
            "external": {
              "type": "integer",
              "minimum": 0
            },
            "note": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "byLane": {
          "type": "object",
          "description": "Who performs each step. Orthogonal to `byType`: `git fetch` is a stage the tool runs, `判断分支是否落后` is a stage the reader runs.",
          "required": [
            "reader",
            "tool",
            "model",
            "output"
          ],
          "additionalProperties": true,
          "properties": {
            "reader": {
              "type": "integer",
              "minimum": 0
            },
            "tool": {
              "type": "integer",
              "minimum": 0
            },
            "model": {
              "type": "integer",
              "minimum": 0
            },
            "output": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "lowConfidence": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0
        },
        "noteCoverage": {
          "type": "object",
          "description": "Static traceability of explanatory cards. Notes and gates both count: a gate bound to an action is traceable, a Skill-wide one is scoped, and only a note with neither is orphaned.",
          "required": [
            "total",
            "associated",
            "global",
            "unbound",
            "coverageRate",
            "orphanTextRate"
          ],
          "additionalProperties": true,
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "associated": {
              "type": "integer",
              "minimum": 0
            },
            "global": {
              "type": "integer",
              "minimum": 0
            },
            "unbound": {
              "type": "integer",
              "minimum": 0
            },
            "coverageRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "orphanTextRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "associations": {
      "type": "array",
      "description": "Non-execution relationships. A note points at what it explains; a gate points at the action it constrains, and every gate has exactly one such binding.",
      "items": {
        "$ref": "#/$defs/association"
      }
    }
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "description": "A contiguous 1-based inclusive line range plus the hash of exactly those lines. The hash is the only staleness judge: a range that moved but whose bytes are identical is still current.",
      "required": [
        "heading",
        "start",
        "end",
        "sha"
      ],
      "additionalProperties": true,
      "properties": {
        "heading": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Enclosing headings, outermost first."
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the exact lines in the range, joined with a newline. A range that moved but whose bytes are identical is current; a range whose bytes changed is stale, even at the same line numbers."
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "label",
        "lane",
        "text",
        "raw",
        "anchor",
        "branches",
        "confidence",
        "flags"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique within the document; a slug of the label, suffixed on collision. Never reassigned by an edit."
        },
        "type": {
          "enum": [
            "stage",
            "decision",
            "gate",
            "artifact",
            "external",
            "note"
          ],
          "description": "stage = an action supported by the source, decision = a fork, gate = a rule that can stop the flow, artifact = an output shape, external = a call out of the skill, note = background, fact or explanation that is not a step."
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "description": "Second line of the card: the artifact, condition or expectation the source states next to the step. Absent when the source offers nothing short and authored — never synthesised."
        },
        "lane": {
          "enum": [
            "reader",
            "tool",
            "model",
            "output"
          ],
          "description": "Who performs the step. Orthogonal to `type`; drives the swimlane the card is drawn in."
        },
        "phase": {
          "type": "string",
          "description": "The heading that names the stage this node belongs to (`Phase 2：UAT vs PROD 工单对齐`). Absent when no enclosing heading names a stage."
        },
        "text": {
          "type": "string",
          "description": "Readable body for the UI, newlines collapsed, truncated."
        },
        "raw": {
          "type": "string",
          "description": "The exact source lines. An edit is only safe against this, not against `text`."
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "when"
            ],
            "additionalProperties": true,
            "properties": {
              "when": {
                "type": "string",
                "minLength": 1,
                "description": "The guard, as the author wrote it."
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "description": "Target node id, when one could be named. Absent means unresolved, which the node flags."
              }
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Semantic confidence in AI analysis. In the compatibility rules path this is a fixed rule score rather than a probability; `source.method` and `rule` distinguish the two paths."
        },
        "rule": {
          "type": "string",
          "description": "Which classification rule produced this node (`paragraph`, `table-of-modes`, `pinned-marker`, …), so the score beside it can be explained."
        },
        "source": {
          "enum": [
            "extractor",
            "analysis",
            "sidecar"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "enum": [
              "low-confidence",
              "unresolved-branch",
              "stale",
              "relocated",
              "broken",
              "dropped-by-sidecar",
              "orphan-note"
            ]
          }
        },
        "topics": {
          "type": "array",
          "items": { "type": "string" },
          "description": "What this card is about, as the analyst wrote it. Used to bind gates to the cards they govern; absent on proposals written before the field existed."
        },
        "noteRole": {
          "enum": [
            "principle",
            "rationale",
            "definition",
            "trigger",
            "context",
            "risk",
            "example",
            "reference"
          ],
          "description": "Semantic role of a note. Only present on note nodes."
        },
        "associationScope": {
          "enum": [
            "node",
            "skill",
            "unbound"
          ],
          "description": "Whether the card supports one structural node, the whole Skill, or has no defensible target. Gates use it too: a gate with a `constrains` association is `node`, a rule section's card is `skill`, and a gate that has neither is a defect — the binding pass in src/constraints.ts always finds one."
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to",
        "kind"
      ],
      "additionalProperties": true,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "string",
          "description": "The guard, for a branch edge."
        },
        "reason": {
          "type": "string",
          "description": "Why the edge exists, in the analysis's words; a cross-section sequence quotes the connective here and is counted as justified rather than as a defect."
        },
        "kind": {
          "enum": [
            "sequence",
            "branch"
          ]
        }
      }
    },
    "association": {
      "type": "object",
      "required": [
        "from",
        "to",
        "relation",
        "evidence",
        "confidence"
      ],
      "additionalProperties": true,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1,
          "description": "Source note id."
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "description": "Target action, gate, decision, external call, or artifact id."
        },
        "relation": {
          "enum": [
            "supports",
            "constrains",
            "informs",
            "explains-output"
          ]
        },
        "evidence": {
          "enum": [
            "explicit-reference",
            "same-section",
            "nearest-structural",
            "ai-analysis"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "description": "Why the analyst selected this target."
        }
      }
    }
  }
}
