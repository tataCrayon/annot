{
  "name": "annot",
  "version": "0.3.0",
  "description": "Annotate any agent skill: turn SKILL.md into an anchored flow graph you can inspect, diff and edit by natural language.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "annot": "./bin/annot.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./parse": "./src/parse.ts",
    "./flow": "./src/flow.ts",
    "./analysis": "./src/analysis.ts",
    "./drift": "./src/drift.ts",
    "./audit": "./src/audit.ts",
    "./search": "./src/search.ts",
    "./context": "./src/context.ts",
    "./improve": "./src/improve.ts",
    "./repair": "./src/repair.ts",
    "./manifest": "./src/manifest.ts",
    "./render": "./src/render.ts",
    "./visual": "./src/visual.ts",
    "./browser": "./src/browser.ts",
    "./web": "./src/web.ts",
    "./workbench": "./src/workbench.ts",
    "./flow.schema.json": "./schema/flow.schema.json",
    "./analysis.schema.json": "./schema/analysis.schema.json"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "tools",
    "web",
    "docs/assets",
    "test/fixtures",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "keywords": [
    "agent-skills",
    "skill",
    "flowchart",
    "annotate",
    "codex",
    "zcode",
    "local-web",
    "deepseek-harness",
    "eval"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts test/*.test.js",
    "sandbox": "bash sandbox/run.sh",
    "annotate": "node src/cli.ts annotate",
    "check": "node src/cli.ts check",
    "audit": "node src/cli.ts audit",
    "verify": "node src/cli.ts verify",
    "web": "node src/cli.ts web",
    "render": "node src/cli.ts render"
  }
}
